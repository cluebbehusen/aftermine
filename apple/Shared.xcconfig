// Build settings every app target shares. Each platform's file includes
// this one, then the ignored Local.xcconfig.
//
// Set your signing team in Local.xcconfig (copy Local.xcconfig.example),
// which git ignores. Picking a team in Xcode's Signing pane instead
// writes it into the shared project file.

PRODUCT_NAME = Aftermine
PRODUCT_BUNDLE_IDENTIFIER = dev.luebbehusen.aftermine
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ARCHS = arm64

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// The Rust build runs Cargo, which a sandboxed script cannot reach.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Xcode's PNG rewriting produces files the shell's decoder cannot read.
COMPRESS_PNG_FILES = NO
STRIP_PNG_TEXT = NO

DEBUG_INFORMATION_FORMAT = dwarf
ALWAYS_SEARCH_USER_PATHS = NO
